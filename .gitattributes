# Set default behavior to normalize all files and force LF (\n) on checkout
* text=auto eol=lf

# Explicitly ensure text source files use LF
*.css text eol=lf
*.md text eol=lf
*.smd text eol=lf
*.shtml text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.html text eol=lf

# Keep binary files untouched so they don't get corrupted
*.png binary
*.jpg binary
*.gif binary
*.ico binary